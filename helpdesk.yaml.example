# Helpdesk configuration. Copy to helpdesk.yaml (or set HELPDESK_CONFIG).
# Every key can be overridden by env: HELPDESK_DATA_DIR, HELPDESK_NATS_URLS, ...
# List-valued keys (nats.urls, inbound.allowed_ips) take a WHITESPACE-separated
# value: HELPDESK_INBOUND_ALLOWED_IPS="192.0.2.10 198.51.100.0/24". A comma-
# joined value parses as one entry and would allow every IP.
#
# SMTP and the application URL are PocketBase settings (dashboard at /_), not
# keys here. Full reference: docs/configuration.md.

# PocketBase data directory (SQLite database, uploads).
data_dir: pb_data

# Optional operator branding overlay. Point `dir` at a host directory holding
# any of theme.css, logo.svg, and branding.json; the helpdesk serves them under
# /branding/* so an operator can override the app name, logo, and DaisyUI theme
# without rebuilding. branding.json shape: { "appName": "...", "logo": "logo.svg" }.
# Empty / unset (or HELPDESK_BRANDING_DIR) = embedded defaults. See branding.example/.
branding:
  dir: ""

# Auto-close tickets left `resolved` this many days, via a daily cron. Measured
# from `resolved_at`, so an unrelated edit while resolved does not reset the
# clock. The window is the grace period in which a requester reply reopens the
# ticket. 0 disables it, and tickets then close only when staff close them.
auto_close_resolved_days: 7

# NATS connection to the platform operator's hub account. Leave urls empty to
# run without NATS (tickets then arrive only via portal/agent/webhook/email).
#
# The creds file is a Stone-Age.io-issued nats_user in the hub account,
# permission-scoped to `sub helpdesk.>`. A managed customer org's ticket events
# are imported into the hub as helpdesk.{orgCode}.tickets.> by the platform's
# operator-signed subject rewrite, where {orgCode} is `customers.code` — the
# ecosystem's tenant token (ADR 0002 in platform-docs). To also emit outbound
# notification events (see notify_stream), the grant is widened to
# `pub helpdesk.>` — the helpdesk is otherwise blind to it.
nats:
  urls: []
  # urls: ["nats://localhost:4222"]
  creds_file: ""
  stream: HELPDESK_EVENTS
  durable: helpdesk-ingest
  # Outbound notification-event stream the helpdesk creates + owns (subjects
  # helpdesk.*.evt.>). Used only when a notification template has
  # publish_nats enabled; setup fails softly if publish isn't granted.
  notify_stream: HELPDESK_NOTIFICATIONS
  # This helpdesk's Thing code on the platform. It goes into the NATS service
  # discovery metadata so the console can find the running process. Empty
  # skips discovery registration; nothing else needs it.
  code: ""

# Inbound email via an email-parsing provider (Postmark first). The provider
# receives forwarded mail, parses the MIME, and POSTs clean JSON to
# /api/helpdesk/inbound/email/{provider} — the helpdesk holds no mailbox
# credentials. The route is registered ONLY when `secret` is set, so leaving it
# empty disables inbound email entirely and mail arrives only via
# portal/agent/webhook/NATS. See docs/email-ingestion.md.
inbound:
  # Basic-auth password for the email webhook. Empty = inbound email disabled.
  secret: ""
  # Optional. Restricts the webhook to the provider's egress ranges.
  allowed_ips: []
  # allowed_ips: ["192.0.2.10", "198.51.100.0/24"]
  # Reserved: read but NOT wired in v1. Replies thread via the PocketBase
  # sender address.
  # reply_to: ""

# Readiness, at GET /api/ready. Unauthenticated, with one body for everyone:
# its callers are orchestrators, load balancers and uptime checkers, none of
# which holds a PocketBase session. Put it behind a reverse proxy to restrict
# it. There is deliberately no `enabled` key — readiness is a contract with
# whatever runs this process, not something an install turns off.
#
# A background prober runs the checks and the endpoint serves the last result,
# so a probe never waits on a slow check. `interval_seconds` is therefore how
# stale an answer may be, not what a probe costs. 503 is returned only when a
# check FAILS; a warning is 200, because a probe can only restart or evict the
# process and neither fixes a misconfiguration.
readiness:
  interval_seconds: 30
  timeout_seconds: 10

# Prometheus exposition at GET /metrics. Unlike readiness this can be turned
# off, since an install may reasonably not want the port exposed at all.
#
# `token`, when set, is required as `Authorization: Bearer <token>` or as the
# PASSWORD half of Basic auth (the username is ignored, so a scraper's
# basic_auth block works as-is). It is not PocketBase auth: PocketBase tokens
# are JWTs that expire, and scrapers cannot refresh them.
#
# Empty leaves the endpoint open, which is why no series carries a customer
# label — an open port must not put a tenant's name next to a ticket count.
metrics:
  enabled: true
  token: ""
